# Postgres dedicado (Coolify em produção, local em dev)
DATABASE_URL=postgres://usuario:senha@localhost:5432/londrina_centro

# Assina os cookies de sessão dos três perfis. Sem isso, todo deploy derruba
# quem está logado — inclusive no meio de uma apresentação.
SESSION_SECRET=troque-por-64-hex-aleatorios

# Senha única do painel do administrador
ADMIN_SENHA=

# Fase 1: com o token preenchido, o checkout deixa o modo demonstração e passa
# a cobrar de verdade (Pix, cartão à vista e em 3x).
MERCADO_PAGO_TOKEN=

PORT=3000
